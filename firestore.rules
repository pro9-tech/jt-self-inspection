rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: records
    // Document ID: {recordId}
    // Fields:
    //   - id: string (required) - Unique ID for the record
    //   - itemName: string (required) - Name of the product
    //   - lotNumber: string (required) - Lot number
    //   - fillingDate: string (required) - Date of filling
    //   - standardWeight: number (required) - Target weight
    //   - underweightTolerance: number (required) - Allowed underweight deviation
    //   - overweightTolerance: number (required) - Allowed overweight deviation
    //   - operator: string (required) - Name of the operator
    //   - verifier: string (optional) - Name of the verifier
    //   - measurements: list (required) - List of measurement objects
    //   - createdAt: number (required) - Creation timestamp
    //   - uid: string (required) - Owner UID
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.uid;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email == "pro9@janytree.com" && request.auth.token.email_verified == true) ||
        (exists(/databases/$(database)/documents/settings/global) && (
          get(/databases/$(database)/documents/settings/global).data.operators.any(op => op.get('email', '') == request.auth.token.email && op.get('role', 'user') == 'admin') ||
          get(/databases/$(database)/documents/settings/global).data.verifiers.any(ve => ve.get('email', '') == request.auth.token.email && ve.get('role', 'user') == 'admin')
        ))
      );
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Domain Validators
    function isValidRecord(data) {
      return hasRequiredFields(['id', 'mainMode', 'subMode', 'itemName', 'lotNumber', 'fillingDate', 'operator', 'measurements', 'createdAt', 'uid']) &&
             data.id is string && data.id.size() > 0 && data.id.size() < 100 &&
             data.mainMode in ['충진', '포장'] &&
             data.subMode in ['충진1', '충진2'] &&
             data.itemName is string && data.itemName.size() < 200 &&
             data.lotNumber is string && data.lotNumber.size() < 100 &&
             data.fillingDate is string && data.fillingDate.size() > 0 && data.fillingDate.size() < 20 &&
             (data.standardWeight == null || data.standardWeight is number) &&
             (data.underweightTolerance == null || data.underweightTolerance is number) &&
             (data.overweightTolerance == null || data.overweightTolerance is number) &&
             data.operator is string && data.operator.size() < 100 &&
             data.measurements is list && data.measurements.size() <= 100 &&
             data.createdAt is number &&
             data.uid is string;
    }

    function isValidSettings(data) {
      return hasRequiredFields(['uid']) &&
             data.uid is string &&
             (!('items' in data) || data.items is list) &&
             (!('operators' in data) || data.operators is list) &&
             (!('verifiers' in data) || data.verifiers is list) &&
             (!('fillingScriptUrl' in data) || data.fillingScriptUrl is string) &&
             (!('packagingScriptUrl' in data) || data.packagingScriptUrl is string);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /records/{recordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidRecord(request.resource.data);
      allow update: if isAuthenticated() && isValidRecord(request.resource.data);
      allow delete: if isAuthenticated();
    }

    match /settings/{settingsId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && isValidSettings(request.resource.data);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(userId) && request.resource.data.role == 'user';
      allow update: if isAuthenticated() && (isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role));
      allow delete: if isAdmin();
    }
  }
}
